# PostgreSQL connection used by the running application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional direct connection for Drizzle migrations.
# If omitted, migrations use DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Better Auth. Generate a unique secret for each environment.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
